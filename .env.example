# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Path to service account JSON file (local development)
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# Full JSON string of service account (for Render/Railway deployment)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Drive folder ID to search within
# Get from folder URL: drive.google.com/drive/folders/FOLDER_ID_HERE
DRIVE_FOLDER_ID=your_folder_id_here

# FastAPI backend URL
# Local: http://localhost:8000
# Production: https://your-backend.onrender.com
BACKEND_URL=http://localhost:8000
